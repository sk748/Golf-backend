{
  "openapi": "3.0.3",
  "info": {
    "title": "Karen Golf Management Platform API",
    "description": "REST API for Karen Country Club golf operations — tournament management, junior development, coaching, scoring and WHS handicaps.",
    "version": "1.0.0"
  },
  "servers": [{ "url": "http://localhost:5000", "description": "Local dev" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "fields": { "type": "object" }
            }
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string" },
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "full_name": { "type": "string" },
          "phone": { "type": "string", "nullable": true },
          "role": { "type": "string", "enum": ["admin","coach","committee","parent","player"] },
          "membership_type": { "type": "string", "enum": ["full","social","guest","junior"] },
          "handicap_index": { "type": "number", "nullable": true },
          "cdh_number": { "type": "string", "nullable": true },
          "is_active": { "type": "boolean" }
        }
      },
      "Course": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "par": { "type": "integer" },
          "altitude_ft": { "type": "integer", "nullable": true },
          "grass_type": { "type": "string", "nullable": true }
        }
      },
      "TeeSet": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "course_id": { "type": "integer" },
          "name": { "type": "string", "enum": ["white","yellow","blue","red"] },
          "gender": { "type": "string", "enum": ["men","women"] },
          "course_rating": { "type": "number" },
          "slope_rating": { "type": "integer" },
          "total_yards": { "type": "integer" }
        }
      },
      "Hole": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "course_id": { "type": "integer" },
          "hole_number": { "type": "integer", "minimum": 1, "maximum": 18 },
          "par": { "type": "integer", "enum": [3, 4, 5] },
          "stroke_index": { "type": "integer", "minimum": 1, "maximum": 18 },
          "white_yards": { "type": "integer" },
          "yellow_yards": { "type": "integer" },
          "blue_yards": { "type": "integer" },
          "red_yards": { "type": "integer" }
        }
      },
      "Tournament": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "year": { "type": "integer" },
          "format": { "type": "string" },
          "handicap_allowance": { "type": "number" },
          "max_stroke_diff": { "type": "integer" },
          "min_games": { "type": "integer" },
          "max_games": { "type": "integer" },
          "qualify_top_n": { "type": "integer" },
          "points_win": { "type": "integer" },
          "points_tie": { "type": "integer" },
          "points_loss": { "type": "integer" },
          "penalty_late_cancel": { "type": "integer" },
          "penalty_declined": { "type": "integer" },
          "status": { "type": "string", "enum": ["registration","round_robin","knockout","complete"] }
        }
      },
      "Team": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "tournament_id": { "type": "integer" },
          "name": { "type": "string" },
          "player_1_id": { "type": "string" },
          "player_1_handicap": { "type": "number" },
          "player_2_id": { "type": "string" },
          "player_2_handicap": { "type": "number" },
          "is_active": { "type": "boolean" }
        }
      },
      "Match": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "tournament_id": { "type": "integer" },
          "match_date": { "type": "string", "format": "date", "nullable": true },
          "tee_played": { "type": "string", "enum": ["white","yellow","blue","red"] },
          "starting_tee": { "type": "string", "enum": ["hole_1","hole_10"] },
          "team_a_id": { "type": "integer" },
          "team_b_id": { "type": "integer" },
          "result": { "type": "string", "enum": ["team_a_win","team_b_win","tie"], "nullable": true },
          "winner_id": { "type": "integer", "nullable": true },
          "score_description": { "type": "string", "nullable": true },
          "stage": { "type": "string", "enum": ["round_robin","round_of_16","quarter","semi","final"] }
        }
      },
      "LeaderboardRow": {
        "type": "object",
        "properties": {
          "rank": { "type": "integer" },
          "team_id": { "type": "integer" },
          "team_name": { "type": "string" },
          "played": { "type": "integer" },
          "wins": { "type": "integer" },
          "ties": { "type": "integer" },
          "losses": { "type": "integer" },
          "match_points": { "type": "integer" },
          "late_cancel_penalty": { "type": "integer" },
          "declined_penalty": { "type": "integer" },
          "total_points": { "type": "integer" },
          "qualified": { "type": "boolean" }
        }
      },
      "JuniorProfile": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "user_id": { "type": "string" },
          "parent_id": { "type": "string" },
          "date_of_birth": { "type": "string", "format": "date" },
          "gender": { "type": "string", "enum": ["male","female"] },
          "current_level": { "type": "integer", "minimum": 1, "maximum": 9 },
          "band_id": { "type": "integer" },
          "has_handicap": { "type": "boolean" },
          "handicap_index": { "type": "number", "nullable": true },
          "experience": { "type": "string", "enum": ["beginner","lt_1yr","1_3yr","4_6yr","7_10yr"] },
          "availability": { "type": "string", "enum": ["twice_weekly","weekends_only","more_than_twice","holidays_only"] },
          "tournament_ready": { "type": "boolean" }
        }
      },
      "Evaluation": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "junior_id": { "type": "integer" },
          "coach_id": { "type": "string" },
          "report_month": { "type": "string", "format": "date" },
          "current_level": { "type": "integer" },
          "attendance_count": { "type": "integer" },
          "assessment": { "type": "string", "enum": ["below_expectation","meeting_expectation","exceeding_expectation"] },
          "recommendation": { "type": "string", "enum": ["continue_level","move_next_level"] },
          "coach_signed": { "type": "boolean" },
          "committee_signed": { "type": "boolean" }
        }
      },
      "Round": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "user_id": { "type": "string" },
          "course_id": { "type": "integer" },
          "tee_set_id": { "type": "integer" },
          "date_played": { "type": "string", "format": "date" },
          "round_type": { "type": "string", "enum": ["casual","tournament","competition"] },
          "gross_score": { "type": "integer" },
          "score_differential": { "type": "number", "nullable": true },
          "handicap_before": { "type": "number", "nullable": true },
          "handicap_after": { "type": "number", "nullable": true }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "class_id": { "type": "integer", "nullable": true },
          "coach_id": { "type": "string" },
          "session_type": { "type": "string", "enum": ["group","one_on_one","evaluation","tournament_prep"] },
          "date": { "type": "string", "format": "date" },
          "start_time": { "type": "string" },
          "end_time": { "type": "string" },
          "status": { "type": "string", "enum": ["scheduled","completed","cancelled"] }
        }
      }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["email","password","full_name"], "properties": { "email": { "type": "string" }, "password": { "type": "string" }, "full_name": { "type": "string" }, "role": { "type": "string" }, "phone": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "Token + user" }, "400": { "description": "Validation error" }, "409": { "description": "Email already registered" } }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login",
        "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["email","password"], "properties": { "email": { "type": "string" }, "password": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Token + user" }, "401": { "description": "Invalid credentials" } }
      }
    },
    "/api/auth/me": {
      "get": { "tags": ["Auth"], "summary": "Get own profile", "responses": { "200": { "description": "User object" }, "401": { "description": "Unauthenticated" } } }
    },
    "/api/auth/profile": {
      "put": { "tags": ["Auth"], "summary": "Update own profile", "responses": { "200": { "description": "Updated user" } } }
    },
    "/api/users": {
      "get": { "tags": ["Users"], "summary": "List users (admin/coach/committee)", "parameters": [{ "name": "role", "in": "query", "schema": { "type": "string" } }, { "name": "membership_type", "in": "query", "schema": { "type": "string" } }, { "name": "search", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "List of users" } } },
      "post": { "tags": ["Users"], "summary": "Create user (admin only)", "responses": { "201": { "description": "Created user" } } }
    },
    "/api/users/{id}": {
      "get": { "tags": ["Users"], "summary": "Get user by ID", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "User" }, "404": { "description": "Not found" } } },
      "put": { "tags": ["Users"], "summary": "Update user (admin or self)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Updated user" } } },
      "delete": { "tags": ["Users"], "summary": "Delete user (admin only)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "Deleted" } } }
    },
    "/api/seed": {
      "post": { "tags": ["Seed"], "summary": "Seed reference data (course, holes, tees, level bands, tournament)", "security": [], "responses": { "201": { "description": "Seeded" } } }
    },
    "/api/courses": {
      "get": { "tags": ["Courses"], "summary": "List courses", "responses": { "200": { "description": "List" } } },
      "post": { "tags": ["Courses"], "summary": "Create course (admin)", "responses": { "201": { "description": "Created" } } }
    },
    "/api/courses/{id}": {
      "get": { "tags": ["Courses"], "summary": "Get course", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Course" } } },
      "put": { "tags": ["Courses"], "summary": "Update course (admin)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Updated" } } },
      "delete": { "tags": ["Courses"], "summary": "Delete course (admin)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "204": { "description": "Deleted" } } }
    },
    "/api/courses-with-tees": {
      "get": { "tags": ["Courses"], "summary": "All courses with embedded tee sets (used by ScorecardForm)", "responses": { "200": { "description": "Courses with tees array" } } }
    },
    "/api/tee-sets": {
      "get": { "tags": ["Courses"], "summary": "List tee sets", "parameters": [{ "name": "course_id", "in": "query", "schema": { "type": "integer" } }], "responses": { "200": { "description": "List" } } },
      "post": { "tags": ["Courses"], "summary": "Create tee set (admin)", "responses": { "201": { "description": "Created" } } }
    },
    "/api/tee-sets/{id}": {
      "get": { "tags": ["Courses"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Tee set" } } },
      "put": { "tags": ["Courses"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Updated" } } },
      "delete": { "tags": ["Courses"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "204": { "description": "Deleted" } } }
    },
    "/api/holes": {
      "get": { "tags": ["Courses"], "summary": "List holes", "parameters": [{ "name": "course_id", "in": "query", "schema": { "type": "integer" } }], "responses": { "200": { "description": "List" } } },
      "post": { "tags": ["Courses"], "summary": "Create hole (admin)", "responses": { "201": { "description": "Created" } } }
    },
    "/api/holes/{id}": {
      "get": { "tags": ["Courses"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Hole" } } },
      "put": { "tags": ["Courses"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Updated" } } },
      "delete": { "tags": ["Courses"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "204": { "description": "Deleted" } } }
    },
    "/api/tournaments": {
      "get": { "tags": ["Tournaments"], "summary": "List tournaments", "parameters": [{ "name": "year", "in": "query", "schema": { "type": "integer" } }, { "name": "status", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "List" } } },
      "post": { "tags": ["Tournaments"], "summary": "Create tournament (admin)", "responses": { "201": { "description": "Created" } } }
    },
    "/api/tournaments/{id}": {
      "get": { "tags": ["Tournaments"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Tournament" } } },
      "put": { "tags": ["Tournaments"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Updated" } } },
      "delete": { "tags": ["Tournaments"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "204": { "description": "Deleted" } } }
    },
    "/api/tournaments/{id}/leaderboard": {
      "get": { "tags": ["Tournaments"], "summary": "Ranked leaderboard with points, penalties, qualification", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Array of LeaderboardRow" } } }
    },
    "/api/tournaments/{id}/head-to-head": {
      "get": { "tags": ["Tournaments"], "summary": "Direct head-to-head record between two teams", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }, { "name": "team_a", "in": "query", "required": true, "schema": { "type": "integer" } }, { "name": "team_b", "in": "query", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "H2H record" } } }
    },
    "/api/matches/{id}/stroke-calc": {
      "get": { "tags": ["Tournaments"], "summary": "WHS stroke allocation for a match", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Stroke allocation per hole" } } }
    },
    "/api/teams": {
      "get": { "tags": ["Tournaments"], "parameters": [{ "name": "tournament_id", "in": "query", "schema": { "type": "integer" } }, { "name": "search", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "List" } } },
      "post": { "tags": ["Tournaments"], "responses": { "201": { "description": "Created" } } }
    },
    "/api/teams/{id}": {
      "get": { "tags": ["Tournaments"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Team" } } },
      "put": { "tags": ["Tournaments"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Updated" } } },
      "delete": { "tags": ["Tournaments"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "204": { "description": "Deleted" } } }
    },
    "/api/matches": {
      "get": { "tags": ["Tournaments"], "parameters": [{ "name": "tournament_id", "in": "query", "schema": { "type": "integer" } }, { "name": "team_id", "in": "query", "schema": { "type": "integer" } }, { "name": "stage", "in": "query", "schema": { "type": "string" } }, { "name": "result", "in": "query", "schema": { "type": "string" } }, { "name": "date_from", "in": "query", "schema": { "type": "string" } }, { "name": "date_to", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "List" } } },
      "post": { "tags": ["Tournaments"], "responses": { "201": { "description": "Created" } } }
    },
    "/api/matches/{id}": {
      "get": { "tags": ["Tournaments"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Match" } } },
      "put": { "tags": ["Tournaments"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Updated" } } },
      "delete": { "tags": ["Tournaments"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "204": { "description": "Deleted" } } }
    },
    "/api/juniors": {
      "get": { "tags": ["Juniors"], "summary": "List juniors (parents scoped to own children)", "parameters": [{ "name": "parent_id", "in": "query", "schema": { "type": "string" } }, { "name": "band_id", "in": "query", "schema": { "type": "integer" } }, { "name": "current_level", "in": "query", "schema": { "type": "integer" } }, { "name": "age_min", "in": "query", "schema": { "type": "integer" } }, { "name": "age_max", "in": "query", "schema": { "type": "integer" } }], "responses": { "200": { "description": "List" } } },
      "post": { "tags": ["Juniors"], "summary": "Create junior profile (admin/coach)", "responses": { "201": { "description": "Created" } } }
    },
    "/api/juniors/{id}": {
      "get": { "tags": ["Juniors"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Junior profile" } } },
      "put": { "tags": ["Juniors"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Updated" } } },
      "delete": { "tags": ["Juniors"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "204": { "description": "Deleted" } } }
    },
    "/api/juniors/{id}/progress": {
      "get": { "tags": ["Juniors"], "summary": "Junior progress: level history, evaluations, attendance, benchmarks", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Progress data" } } }
    },
    "/api/juniors/{id}/monthly-report": {
      "get": { "tags": ["Juniors"], "summary": "Full monthly report for a junior", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }, { "name": "month", "in": "query", "required": true, "schema": { "type": "string", "example": "2026-03-01" } }], "responses": { "200": { "description": "Monthly report" } } }
    },
    "/api/evaluations/summary": {
      "get": { "tags": ["Evaluations"], "summary": "Band summary for a month (coach/committee/admin)", "parameters": [{ "name": "band_id", "in": "query", "required": true, "schema": { "type": "integer" } }, { "name": "month", "in": "query", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Summary array" } } }
    },
    "/api/evaluations": {
      "get": { "tags": ["Evaluations"], "parameters": [{ "name": "junior_id", "in": "query", "schema": { "type": "integer" } }, { "name": "coach_id", "in": "query", "schema": { "type": "string" } }, { "name": "report_month", "in": "query", "schema": { "type": "string" } }, { "name": "coach_signed", "in": "query", "schema": { "type": "boolean" } }, { "name": "committee_signed", "in": "query", "schema": { "type": "boolean" } }], "responses": { "200": { "description": "List" } } },
      "post": { "tags": ["Evaluations"], "summary": "Create evaluation (coach/admin)", "responses": { "201": { "description": "Created" } } }
    },
    "/api/evaluations/{id}": {
      "get": { "tags": ["Evaluations"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Evaluation" } } },
      "put": { "tags": ["Evaluations"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Updated" } } },
      "delete": { "tags": ["Evaluations"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "204": { "description": "Deleted" } } }
    },
    "/api/evaluations/{id}/coach-sign": {
      "post": { "tags": ["Evaluations"], "summary": "Coach signs evaluation", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Signed evaluation" }, "403": { "description": "Not the assigned coach" } } }
    },
    "/api/evaluations/{id}/committee-sign": {
