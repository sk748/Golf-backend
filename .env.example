# ── Karen Golf Management Platform — Environment Variables ────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# ── Flask ─────────────────────────────────────────────────────────────────────
# Which config class to load (DevelopmentConfig | ProductionConfig | TestingConfig)
APP_SETTINGS=config.DevelopmentConfig

# Secret key used to sign JWTs and Flask sessions.
# Generate a strong key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# Development:  postgresql://postgres:postgres@localhost/karen_db
# Production:   get from your hosting provider (Render, Supabase, etc.)
DATABASE_URI=postgresql://postgres:postgres@localhost/karen_db

# Test database used when APP_SETTINGS=config.TestingConfig
TEST_DATABASE_URI=postgresql://postgres:postgres@localhost/karen_test_db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development:  http://localhost:3000
# Production:   https://yourdomain.com
FRONTEND_URL=http://localhost:3000
