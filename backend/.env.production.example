# Flask secret key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-hex-chars

# Backend's Postgres connection string, pointing at the compose `db` service
DATABASE_URI=postgresql://karen:replace-with-db-password@db:5432/karen_db

# Public origin of the deployed app, used for CORS (comma-separated, no spaces)
FRONTEND_URL=https://karengolf.example.com

# Loads ProductionConfig (debug off, swagger off, rate limits enforced)
APP_SETTINGS=config.ProductionConfig

# Rate-limit storage, matching the compose `redis` service name
REDIS_URL=redis://redis:6379/0

# Domain Caddy serves — must also be set in the root-level .env so docker-compose can substitute it
DOMAIN=karengolf.example.com

# Credentials the postgres container is bootstrapped with — must match DATABASE_URI
POSTGRES_USER=karen
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_DB=karen_db
