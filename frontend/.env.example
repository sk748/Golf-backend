# ── Karen Golf — Frontend (Vite) Environment Variables ───────────────────────
# Copy this file to frontend/.env and fill in real values.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER commit .env to source control.
# (Backend env lives in backend/.env.example.)

# In dev the frontend uses relative /api paths proxied to the backend
# (see vite.config.ts), so VITE_API_BASE is left empty. Set it only when the
# frontend is served from a different origin than the API (e.g. a separate
# production host), e.g. https://api.yourdomain.com
VITE_API_BASE=
